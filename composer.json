{
	"name": "pronamic/wp-twinfield",
	"description": "Twinfield library for WordPress.",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu"
		}
	],
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Twinfield\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require": {
		"php": ">=8.2",
		"mpdf/mpdf": "^8.2",
		"pronamic/wp-http": "^1.2",
		"pronamic/wp-money": "^2.4",
		"pronamic/wp-number": "^1.3",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"automattic/wordbless": "^0.4.1",
		"deployer/deployer": "^7.0",
		"overtrue/phplint": "^9.0",
		"php-coveralls/php-coveralls": "^2.6",
		"phpmd/phpmd": "^2.6",
		"pronamic/wp-coding-standards": "^2.0",
		"rector/rector": "^2.0",
		"sensiolabs/security-checker": "^6.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "^2.11",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"extra": {
		"wp-slug": "pronamic-twinfield"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --no-scripts --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-twinfield/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-twinfield/ --slug=pronamic-twinfield",
			"vendor/bin/wp i18n make-mo ./build/pronamic-twinfield/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-twinfield/ --plugin-dirname=pronamic-twinfield --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=pronamic-twinfield",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-twinfield/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-twinfield.pot"
		],
		"deploy": [
			"Composer\\Config::disableProcessTimeout",
			"DEPLOYER_IMPORT=${DEPLOYER_IMPORT:-$HOME/deployer.php} vendor/bin/dep deploy"
		],
		"phpcs": "vendor/bin/phpcs -s -v",
		"phpcbf": "vendor/bin/phpcbf",
		"phplint": "vendor/bin/phplint",
		"post-install-cmd": "WorDBless\\Composer\\InstallDropin::copy",
		"post-update-cmd": "WorDBless\\Composer\\InstallDropin::copy"
	}
}
